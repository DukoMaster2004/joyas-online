# Reemplazar por el número oficial en formato internacional, sin + ni espacios.
VITE_WHATSAPP_NUMBER=51907244112

# Correo oficial (opcional).
VITE_CONTACT_EMAIL=

# Clave privada de Gemini (Google AI Studio); nunca usar prefijo VITE_.
# Copia este archivo como .env y pega aquí tu clave real.
GEMINI_API_KEY=tu_clave_de_gemini
GEMINI_MODEL=gemini-3.6-flash

# La tienda usa el mismo proyecto Firebase que el proyecto de tesis.
# Completa estas variables solo si necesitas reemplazar su configuración web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
